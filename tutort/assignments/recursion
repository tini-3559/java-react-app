// 342. Power of Four

function isPowerOfFour(n: number): boolean {

    let i=0;
    while(n>=Math.pow(4,i))
    {
        if(n===Math.pow(4,i))
        return true;
        else
        {
        isPowerOfFour(i)
        i++;
        }
    }
    return false

