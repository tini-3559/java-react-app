// 1.	Search in rotated array
function search(nums: number[], target: number): number {
    let left = 0;
    let right = nums.length - 1;
    let mid;
    while (left <= right) {
        mid = Math.floor((left + right) / 2)
        if (target === nums[mid])
            return mid;
         if (nums[mid] > nums[right]) { // this condition has to be put to check if sequence lies in first half or second half , then target has to be compared
            if (nums[left] <= target && target < nums[mid])
                right = mid - 1
            else
                left = mid + 1
         } else {
            if (nums[right] >= target && target > nums[mid])
                left = mid + 1
            else
                right = mid - 1
        }
    }

return -1

};


2.Peak Index in mountain array

    function peakIndexInMountainArray(arr: number[]): number {
    // similar to peak element
    let left = 0;
    let right: number = arr.length - 1;
    let mid = 0;
    while (left <= right) {
        mid = Math.floor((left + right) / 2);
        if (arr[mid] < arr[mid + 1])
            left = mid + 1
        else
            right = mid - 1
    }
    //here left>right it means peak .In all other conditions right would be greater
    return left
}


3.	Search in rotated array-ii

function search(nums: number[], target: number): boolean {
    let left = 0;
    let right = nums.length - 1;
    let mid;
    while (left <= right) {
        mid = Math.floor((left + right) / 2)
        if (target === nums[mid])
            return true;
        // edges case due to duplicates
        if (nums[left] == nums[mid] && nums[mid] == nums[right]) {
            left++;
            right--;
            continue;
        }
        if (nums[mid] > nums[right]) { // this condition has to be put to check if sequence lies in first half or second half , then target has to be compared
            if (nums[left] <= target && target < nums[mid])
                right = mid - 1
            else
                left = mid + 1
        } else {
            if (nums[right] >= target && target > nums[mid])
                left = mid + 1
            else
                right = mid - 1
        }
    }

    return false

};


