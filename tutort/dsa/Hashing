// group anagrams

function groupAnagrams(strs: string[]): string[][] {
    const map: Map<string, string[]> = new Map(); //important see map structure in typescript
    let arr:string[]=[];
    for (let str of strs)
    {
      let key=str.split("").sort().join("") 
        if (!map.has(key)) {
           map.set(key,[])
        }
        map.get(key).push(str)
        
    }
    return Array.from(map.values());
   
    
};
