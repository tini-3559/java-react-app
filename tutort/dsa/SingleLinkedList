                this.head = null;
                this.size = 0;

            }
            insertAtBeginning(data: number): void
            {
                if(head === null)
                {
                   head=tail=new Node(data);
                   this.size++;
                }
                else
                {
                    let newNode = new Node(data);
                    newNode.next = this.head;
                    this.head = newNode;
                    this.size++;
                }
                
            }
            insertAtEnd(data: number): void
            {
              if(this.head === null)
              {
                this.head=this.tail=new Node(data);
                this.size++;
              }
              else
              {
                let newNode = new Node(data);
                this.tail.next = newNode;
                this.tail = newNode;
                this.size++;
              } 
