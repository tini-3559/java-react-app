 // Stack implementation in TypeScriptY
 
 class MyStack {
    private maxSize:number;
    private stackArray:number[];
    private top:number;

    constructor(size:number)
     {
        this.maxSize = size;
        this.stackArray = new Array(size);
        this.top = -1;
     }
     push(data)
	 {
     if(this.isFull())
         {
      console.log("Stack Overflow");
            return;
         }
         else{
	 this.stackArray[++this.top]=data
     	 
	 }}
	 pop()
	 {
         if(this.isEmpty())
         {
      console.log("Stack Overflow");
            return;
         }
         else{
	 return this.stackArray[this.top--]	 
	 }}
	 peek()
	 {
         if (this.isEmpty()) {
            console.log("Stack is empty");
            return null;
        }
	 return this.stackArray[this.top]
	 }
	 isEmpty()
	 {
	 return this.top===-1
	 }
	 isFull()
	 {
	 return this.top===this.maxSize-1
	 }
 }
 
 
const stack= new MyStack(3);
console.log("isEmpty",stack.isEmpty())
stack.push(10);
stack.push(20);
stack.push(30);
console.log("stack",stack)
console.log("isFull",stack.isFull())
console.log("peak",stack.peek())
console.log("Pop",stack.pop())






