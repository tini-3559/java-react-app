2. RemoveDuplicates:

import java.util.ArrayList;
import java.util.List;
import java.util.Set;
import java.util.HashSet;


class CheckDuplicates {
  public static List<String> checkDup(String str,List<String> list) {
  Set<String> set=new HashSet<>(list);
  return new ArrayList<>(set);  
  }
   
  public static void main(String[] args)
  {  
  List<String> arrayAsStringList=new ArrayList<String>();
  arrayAsStringList.add("bbc");
  arrayAsStringList.add("abc");
  arrayAsStringList.add("bbc");
  List<String> rem=checkDup("bbc", arrayAsStringList);
  System.out.print(rem);
  }
}

3. Print non-duplicate characters in a string using Java Streams:

import java.util.*;
import java.util.stream.Collectors;

public class Main {
    public static void main(String[] args) {
      List<Integer> numbers= Arrays.asList(1,2,5,7,5,2);
      Set<Integer> seen = new HashSet<>();
      List<Integer> duplicates= numbers.stream().filter(n->!seen.add(n)).collect(Collectors.toList());
      System.out.println(duplicates);
    }
}


