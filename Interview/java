25.Program to find second largest number using streams.
 
import java.util.*;
import java.util.Comparator;
import java.util.Optional;

class Main {
    public static void main(String[] args) {
        System.out.println("Program to find second largest element using streams");
        List<Integer> numbers = Arrays.asList(10, 20, 35, 50, 50, 75, 65);
       
        Optional<Integer> secondLargest=numbers.stream()
        .distinct()
        .sorted(Comparator.reverseOrder())
        .skip(1).
        findFirst();
        System.out.println(secondLargest.get());
}}       

26. Program to find numbers starting with 1.(With boxed)

import java.util.*;
import java.util.Comparator;
import java.util.Optional;
import java.util.stream.Collectors;

class Main {
    public static void main(String[] args) {
        System.out.println("Program to find numbers starting with 1");
        int[] numbers = {10, 121, 35, 50, 50, 75, 65};
       
        List<Integer> numbersStartingwithOne =Arrays.stream(numbers)
        .filter(num->String.valueOf(num).startsWith("1"))
        .boxed()
        .collect(Collectors.toList());
        
        System.out.println(numbersStartingwithOne);
}}
