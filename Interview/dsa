function rotate(nums: number[], k: number): void {
    if (k > nums.length) { k = k % nums.length }
    let temp = nums.slice(nums.length - k, nums.length);
    let length = nums.length - 1;
    nums.splice(0, 0, ...temp)
    nums.splice(length + 1, k)
};
